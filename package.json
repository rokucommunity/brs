{
  "name": "@rokucommunity/brs",
  "version": "0.47.6",
  "description": "An interpreter for the BrightScript language that runs on non-Roku platforms.",
  "author": "Sean Barag <sean@barag.org>",
  "license": "MIT",
  "main": "lib/index.js",
  "typings": "./types/index.d.ts",
  "bin": {
    "brs": "./bin/cli.js"
  },
  "scripts": {
    "preversion": "npm run clean && npm run build && npm run lint && npm run prettier && npm run test",
    "build": "tsc",
    "watch": "tsc -w",
    "clean": "node -e \"const fs=require('fs');for(const dir of ['lib','types'])fs.rmSync(dir,{recursive:true,force:true})\"",
    "test": "jest",
    "test:nocover": "jest --collectCoverage=false",
    "test:debug": "node --inspect-brk ./node_modules/.bin/jest --runInBand -- ",
    "lint": "tslint --project .",
    "prettier:write": "prettier --write \"{bin,src,test}/**/*.{js,ts}\"",
    "prettier": "prettier --check \"{bin,src,test}/**/*.{js,ts}\"",
    "package": "npm run build && npm pack",
    "audit": "npm audit || audit-ci --config ./audit-ci.jsonc"
  },
  "files": [
    "bin/",
    "lib/",
    "types/"
  ],
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^2.20.3",
    "crc": "^3.8.0",
    "dayjs": "^1.11.10",
    "fast-glob": "^3.3.3",
    "long": "^3.2.0",
    "memory-fs": "^0.4.1",
    "nanomatch": "^1.2.13",
    "p-settle": "^2.1.0",
    "sanitize-filename": "^1.6.3",
    "strip-ansi": "^6.0.1",
    "uuid": "^11.1.1",
    "xmldoc": "^1.1.2",
    "yauzl": "^3.4.0"
  },
  "overrides": {
    "micromatch": {
      "picomatch": "^2.3.2",
      "braces": "^3.0.3"
    },
    "form-data": "^4.0.4"
  },
  "devDependencies": {
    "@types/crc": "^3.4.0",
    "@types/istanbul-lib-coverage": "^2.0.3",
    "@types/lolex": "^2.1.3",
    "@types/long": "^3.0.32",
    "@types/memory-fs": "^0.3.2",
    "@types/node": "^22.13.2",
    "@types/p-settle": "^2.0.1",
    "@types/xmldoc": "^1.1.4",
    "@types/yauzl": "^3.4.0",
    "audit-ci": "^7.1.0",
    "jest": "^29.7.0",
    "lolex": "^3.0.0",
    "prettier": "2",
    "tslint": "^5.11.0",
    "tslint-config-prettier": "^1.18.0",
    "typescript": "^5.7.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rokucommunity/brs"
  },
  "bugs": {
    "url": "https://github.com/rokucommunity/brs/issues"
  },
  "homepage": "https://github.com/rokucommunity/brs#readme",
  "jest": {
    "testEnvironment": "node",
    "collectCoverage": true,
    "collectCoverageFrom": [
      "lib/**/*.js"
    ]
  },
  "prettier": {
    "trailingComma": "es5",
    "tabWidth": 4,
    "printWidth": 100,
    "endOfLine": "auto"
  }
}
