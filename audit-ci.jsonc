{
    // Fail on high severity and above. See README "Accepted security advisories" for
    // why each allowlisted entry is safe to defer.
    "$schema": "https://github.com/IBM/audit-ci/raw/main/docs/schema.json",
    "high": true,
    "allowlist": [
        {
            "GHSA-vfj7-8cjw-p6xm": {
                // Added: 2026-10-03
                "active": true,
                "notes": "`braces` <=3.0.3 (prod via `fast-glob`/`micromatch`; also dev via jest): stack exhaustion on deeply nested brace patterns. No patched version is published, so it cannot be upgraded or overridden. The only patterns reaching it are globs from the caller's own project config; no untrusted party supplies them, and a crash only affects the caller's own local process."
            }
        },
        {
            "GHSA-qr28-fpjm-wq7f": {
                // Added: 2026-10-30
                "active": true,
                "notes": "`decode-uri-component` <=0.5.0 (prod via `nanomatch` > `snapdragon` > `source-map-resolve@0.5.3`): quadratic DoS on malformed percent-encoded input (also covers the related exponential-DoS advisory GHSA-vcc3-ghjq-m6fr). snapdragon only calls `source-map-resolve` when compiling with the `sourcemap` option, and brs calls `nanomatch.match` (src/stdlib/File.ts) without it, so the decoder is loaded but never invoked. The only patched release (0.5.1) is ESM-only and outside the `^0.2.0` range, so it cannot be upgraded or overridden."
            }
        }
    ]
}
